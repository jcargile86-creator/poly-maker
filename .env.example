# Polymarket Authentication
PK=your_private_key_here
# BROWSER_ADDRESS: required for SIGNATURE_TYPE 1/2/3 (the proxy/Safe wallet that holds funds).
# Optional for SIGNATURE_TYPE=0 (EOA-direct) — funder is derived from PK.
BROWSER_ADDRESS=your_wallet_address_here
# SIGNATURE_TYPE: 0 = EOA-direct, 1 = POLY_PROXY, 2 = POLY_GNOSIS_SAFE (default), 3 = POLY_1271
# Default 2 matches the bot's original Polymarket-browser-wallet design.
# Set to 0 if you sign with a raw private key (no Polymarket-issued proxy wallet).
SIGNATURE_TYPE=2

# Google Sheets (for data_updater)
SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/1Kt6yGY7CZpB75cLJJAdWo7LSp9Oz7pjqfuVWwgtn7Ns/edit?gid=97507557#gid=97507557
#replace with YOUR url
